{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RiotSwitcher",
  "version": "0.1.0",
  "identifier": "com.giova.riotswitcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Riot Account Switcher",
        "width": 1040,
        "height": 680,
        "minWidth": 440,
        "minHeight": 520,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
